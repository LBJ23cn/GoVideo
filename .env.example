# Docker Compose 环境变量示例。
# 复制为 .env 后按需修改（.env 已被 git 忽略）：
#   cp .env.example .env

# MySQL root 密码（同时用于 API/worker 连接数据库）
MYSQL_PASSWORD=govideo-local
MYSQL_DATABASE=go_video

# RabbitMQ 账号
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT 签名密钥，正式环境务必修改
JWT_SECRET=govideo-docker-dev-secret-change-me

# 阿里云 OSS，留空则关闭上传功能（服务仍可正常启动）
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

# 宿主机端口映射（可选，默认值见 docker-compose.yml）
# WEB_PORT=8081
# API_PORT=8080
# MYSQL_HOST_PORT=13306
# REDIS_HOST_PORT=16379
# RABBITMQ_HOST_PORT=25672
# RABBITMQ_MANAGEMENT_PORT=25673
# PPROF_API_PORT=6060
# PPROF_WORKER_PORT=6061
